      "enum:csharp": "#B8D7A3",
      "property:csharp": "#9CDCFE",
      "interface:csharp": "#B8D7A3",
      "struct:csharp": "#86C691",
      "parameter:csharp": "#9CDCFE",
      "class:csharp": "#4EC9B0"
    }
  },
  "files.watcherExclude": {
